{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-basic-tools.local/schemas/disk-pressure.v1.schema.json",
  "title": "Better Basic Tools Disk Pressure v1",
  "type": "object",
  "required": ["schema", "generated_at", "command", "data"],
  "properties": {
    "schema": { "const": "bbt.disk.pressure.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "command": {
      "type": "object",
      "required": ["argv", "argv_bytes_hex", "cwd", "effective_uid"],
      "properties": {
        "argv": { "type": "array", "items": { "type": "string" } },
        "argv_bytes_hex": {
          "type": "array",
          "items": { "type": "string", "pattern": "^([0-9a-f]{2})*$" }
        },
        "cwd": { "type": ["string", "null"] },
        "effective_uid": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "data": { "$ref": "#/$defs/pressureInfo" }
  },
  "$defs": {
    "pressureInfo": {
      "type": "object",
      "required": ["available", "some", "full", "warnings"],
      "properties": {
        "available": { "type": "boolean" },
        "some": {
          "oneOf": [{ "$ref": "#/$defs/pressureLine" }, { "type": "null" }]
        },
        "full": {
          "oneOf": [{ "$ref": "#/$defs/pressureLine" }, { "type": "null" }]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "pressureLine": {
      "type": "object",
      "required": ["avg10", "avg60", "avg300", "total_stalled_usec"],
      "properties": {
        "avg10": { "type": "number", "minimum": 0 },
        "avg60": { "type": "number", "minimum": 0 },
        "avg300": { "type": "number", "minimum": 0 },
        "total_stalled_usec": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
